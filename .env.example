# Database config (Optional, SQLite is used by default)
# DATABASE_URL=postgres://user:pass@host/dbname

# Email Configuration
# You can test locally by setting EMAIL_BACKEND to console backend (emails will print in terminal instead of sending)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# To send real emails, use the SMTP backend (default)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server details (example for Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Your email credentials
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# Where emails appear to come from
DEFAULT_FROM_EMAIL=your_email@gmail.com

# The email address that receives the form submissions
ADMIN_EMAIL=your_admin_email@gmail.com
